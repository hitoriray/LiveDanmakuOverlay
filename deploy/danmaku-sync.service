[Unit]
Description=LiveDanmakuOverlay Sync Server
After=network.target

[Service]
Type=simple
User=danmaku-sync
Group=danmaku-sync
WorkingDirectory=/opt/danmaku-sync
ExecStart=/opt/danmaku-sync/danmaku-sync-server
EnvironmentFile=/etc/danmaku-sync.env
Restart=on-failure
RestartSec=5
MemoryMax=160M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/danmaku-sync

[Install]
WantedBy=multi-user.target
