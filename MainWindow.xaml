<Window x:Class="LiveDanmakuOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="直播弹幕悬浮窗"
        Height="620" Width="420" MinHeight="260" MinWidth="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Loaded="Window_Loaded" Closing="Window_Closing"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#25FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="6,0,0,0"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#FF168CFF"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="15,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Border x:Name="Surface" CornerRadius="12" Background="#D9181A20"
            BorderBrush="#45FFFFFF" BorderThickness="1" Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="Toolbar" Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="直播弹幕" Foreground="White" FontSize="17" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="功能" Click="ControlCenterButton_Click" Style="{StaticResource SmallButton}"/>
                <Button Grid.Column="2" Content="锁定" Click="LockButton_Click" Style="{StaticResource SmallButton}"/>
                <Button Grid.Column="3" Content="×" Click="HideButton_Click" Style="{StaticResource SmallButton}"
                        FontSize="18" Padding="9,1"/>
            </Grid>

            <Grid x:Name="ConnectionPanel" Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="RoomInput" Height="34" Padding="9,5" VerticalContentAlignment="Center"
                         ToolTip="输入 B站直播间链接或房间号" KeyDown="RoomInput_KeyDown"/>
                <Button x:Name="ConnectButton" Grid.Column="1" Content="连接" Margin="8,0,0,0"
                        Click="ConnectButton_Click" Style="{StaticResource AccentButton}"/>
            </Grid>

            <Canvas x:Name="BarrageCanvas" Grid.Row="2" ClipToBounds="True" Background="Transparent"
                    MinHeight="80" SizeChanged="BarrageCanvas_SizeChanged"/>

            <StackPanel x:Name="StatusPanel" Grid.Row="3" Margin="0,9,18,0">
                <TextBlock x:Name="StatusText" Text="尚未连接" Foreground="#BFFFFFFF" FontSize="12"
                           TextTrimming="CharacterEllipsis" Margin="0,0,0,5"/>
                <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="字号" Foreground="#BFFFFFFF" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Slider x:Name="FontSizeSlider" Width="65" Minimum="12" Maximum="32" Value="18"
                            ValueChanged="FontSizeSlider_ValueChanged"/>
                    <TextBlock Text="速度" Foreground="#BFFFFFFF" VerticalAlignment="Center" Margin="9,0,4,0"/>
                    <Slider x:Name="SpeedSlider" Width="65" Minimum="50" Maximum="220" Value="100"
                            ValueChanged="SpeedSlider_ValueChanged" ToolTip="每秒移动的像素数"/>
                    <TextBlock Text="背景" Foreground="#BFFFFFFF" VerticalAlignment="Center" Margin="9,0,4,0"/>
                    <Slider x:Name="OpacitySlider" Width="55" Minimum="0" Maximum="0.95" Value="0.45"
                            ValueChanged="OpacitySlider_ValueChanged"/>
                    <TextBlock Text="文字" Foreground="#BFFFFFFF" VerticalAlignment="Center" Margin="9,0,4,0"/>
                    <Slider x:Name="TextOpacitySlider" Width="55" Minimum="0.15" Maximum="1" Value="1"
                            ValueChanged="TextOpacitySlider_ValueChanged" ToolTip="文字和表情的透明度"/>
                </WrapPanel>
            </StackPanel>

            <Thumb x:Name="ResizeThumb" Grid.Row="3" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Width="18" Height="18" Cursor="SizeNWSE" DragDelta="ResizeThumb_DragDelta" ToolTip="拖动调整大小">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Path Data="M 3,15 L 15,3 M 8,15 L 15,8 M 13,15 L 15,13"
                                  Stroke="#BFFFFFFF" StrokeThickness="1.5"/>
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>

</Window>
