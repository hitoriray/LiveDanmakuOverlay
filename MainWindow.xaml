<Window x:Class="LiveDanmakuOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="直播弹幕悬浮窗"
        Height="620" Width="420" MinHeight="260" MinWidth="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Loaded="Window_Loaded" Closing="Window_Closing" StateChanged="Window_StateChanged"
        PreviewMouseLeftButtonDown="Window_MouseLeftButtonDown" PreviewMouseMove="Window_MouseMove"
        PreviewMouseLeftButtonUp="Window_MouseLeftButtonUp" LostMouseCapture="Window_LostMouseCapture">
    <Window.Resources>
        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#25FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="6,0,0,0"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#FF168CFF"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="15,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Border x:Name="Surface" CornerRadius="12" Background="#D9181A20"
            BorderBrush="#45FFFFFF" BorderThickness="1" Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="Toolbar" Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="直播弹幕" Foreground="White" FontSize="17" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button x:Name="DanmakuToggleButton" Grid.Column="1" Content="弹幕开" Click="DanmakuToggleButton_Click"
                        Style="{StaticResource SmallButton}" ToolTip="开启或关闭弹幕显示"/>
                <Button Grid.Column="2" Content="功能" Click="ControlCenterButton_Click" Style="{StaticResource SmallButton}"/>
                <Button Grid.Column="3" Content="锁定" Click="LockButton_Click" Style="{StaticResource SmallButton}"/>
                <Button Grid.Column="4" Content="—" Click="MinimizeButton_Click" Style="{StaticResource SmallButton}"
                        FontSize="16" Padding="9,1" ToolTip="最小化到托盘"/>
                <Button x:Name="MaximizeButton" Grid.Column="5" Content="□" Click="MaximizeButton_Click" Style="{StaticResource SmallButton}"
                        FontSize="16" Padding="9,1" ToolTip="最大化"/>
                <Button Grid.Column="6" Content="×" Click="HideButton_Click" Style="{StaticResource SmallButton}"
                        FontSize="18" Padding="9,1"/>
            </Grid>

            <Grid x:Name="ConnectionPanel" Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="RoomInput" Height="34" Padding="9,5" VerticalContentAlignment="Center"
                          IsEditable="True" IsTextSearchEnabled="True" DisplayMemberPath="DisplayName"
                          ToolTip="输入房间号或直播间链接，也可从已保存列表选择" KeyDown="RoomInput_KeyDown"
                          SelectionChanged="RoomInput_SelectionChanged"/>
                <Button x:Name="ConnectButton" Grid.Column="1" Content="连接" Margin="8,0,0,0"
                        Click="ConnectButton_Click" Style="{StaticResource AccentButton}"/>
            </Grid>

            <Grid x:Name="BarrageAreaHost" Grid.Row="2" MinHeight="80" SizeChanged="BarrageAreaHost_SizeChanged">
                <Canvas x:Name="BarrageCanvas" ClipToBounds="True" Background="Transparent"
                        VerticalAlignment="Top" HorizontalAlignment="Stretch"/>
            </Grid>

            <StackPanel x:Name="StatusPanel" Grid.Row="3" Margin="0,9,18,0">
                <TextBlock x:Name="StatusText" Text="尚未连接" Foreground="#BFFFFFFF" FontSize="12"
                           TextTrimming="CharacterEllipsis" Margin="0,0,0,5"/>
                <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="字号" Foreground="#BFFFFFFF" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="FontSizeCombo" Width="58" Height="25" SelectionChanged="FontSizeCombo_SelectionChanged">
                        <ComboBoxItem Content="小" Tag="14"/><ComboBoxItem Content="中" Tag="18"/><ComboBoxItem Content="大" Tag="24"/>
                    </ComboBox>
                    <TextBlock Text="速度" Foreground="#BFFFFFFF" VerticalAlignment="Center" Margin="9,0,4,0"/>
                    <ComboBox x:Name="SpeedCombo" Width="58" Height="25" SelectionChanged="SpeedCombo_SelectionChanged">
                        <ComboBoxItem Content="慢" Tag="70"/><ComboBoxItem Content="中" Tag="110"/><ComboBoxItem Content="快" Tag="170"/>
                    </ComboBox>
                    <TextBlock Text="区域" Foreground="#BFFFFFFF" VerticalAlignment="Center" Margin="9,0,4,0"/>
                    <ComboBox x:Name="DisplayAreaCombo" Width="62" Height="25" SelectionChanged="DisplayAreaCombo_SelectionChanged">
                        <ComboBoxItem Content="10%" Tag="10"/><ComboBoxItem Content="25%" Tag="25"/>
                        <ComboBoxItem Content="50%" Tag="50"/><ComboBoxItem Content="75%" Tag="75"/>
                        <ComboBoxItem Content="100%" Tag="100"/>
                    </ComboBox>
                    <TextBlock Text="背景" Foreground="#BFFFFFFF" VerticalAlignment="Center" Margin="9,0,4,0"/>
                    <Slider x:Name="OpacitySlider" Width="55" Minimum="0" Maximum="1" Value="0.5"
                            TickFrequency="0.1" IsSnapToTickEnabled="True"
                            ValueChanged="OpacitySlider_ValueChanged"/>
                    <TextBlock x:Name="BackgroundOpacityValue" Width="35" Foreground="#BFFFFFFF" VerticalAlignment="Center"/>
                    <TextBlock Text="文字" Foreground="#BFFFFFFF" VerticalAlignment="Center" Margin="9,0,4,0"/>
                    <Slider x:Name="TextOpacitySlider" Width="55" Minimum="0.1" Maximum="1" Value="1"
                            TickFrequency="0.1" IsSnapToTickEnabled="True"
                            ValueChanged="TextOpacitySlider_ValueChanged" ToolTip="文字和表情的透明度"/>
                    <TextBlock x:Name="TextOpacityValue" Width="35" Foreground="#BFFFFFFF" VerticalAlignment="Center"/>
                </WrapPanel>
            </StackPanel>

            <Thumb x:Name="ResizeThumb" Grid.Row="3" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Width="18" Height="18" Cursor="SizeNWSE" DragDelta="ResizeThumb_DragDelta" ToolTip="拖动调整大小">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Path Data="M 3,15 L 15,3 M 8,15 L 15,8 M 13,15 L 15,13"
                                  Stroke="#BFFFFFFF" StrokeThickness="1.5"/>
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>

</Window>
