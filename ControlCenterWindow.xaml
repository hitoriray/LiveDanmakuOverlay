<Window x:Class="LiveDanmakuOverlay.ControlCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="弹幕控制中心" Width="820" Height="560" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterScreen" Background="#FFF5F6F8">
    <Grid Margin="14">
        <TabControl>
            <TabItem Header="屏蔽词">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="KeywordInput" Height="34" Padding="8,5" KeyDown="KeywordInput_KeyDown"
                                 ToolTip="空格和常见标点会被忽略，例如独 轮 车也能匹配独轮车"/>
                        <Button Grid.Column="1" Content="添加屏蔽词" Margin="8,0,0,0" Padding="14,5" Click="AddKeyword_Click"/>
                    </Grid>
                    <ListBox x:Name="KeywordList" Grid.Row="1" Margin="0,10"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="删除选中" Padding="14,5" Click="RemoveKeyword_Click"/>
                        <CheckBox x:Name="SaveBlockedCheck" Content="被屏蔽的弹幕仍保存到历史" Margin="18,0,0,0"
                                  VerticalAlignment="Center" Checked="SaveBlockedCheck_Changed" Unchecked="SaveBlockedCheck_Changed"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="历史搜索">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchInput" Height="34" Padding="8,5" KeyDown="SearchInput_KeyDown"
                                 ToolTip="搜索弹幕正文、用户名或房间号；留空显示最近记录"/>
                        <Button Grid.Column="1" Content="搜索" Margin="8,0,0,0" Padding="18,5" Click="Search_Click"/>
                    </Grid>
                    <DataGrid x:Name="HistoryGrid" Grid.Row="1" Margin="0,10" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" SelectionMode="Extended">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="145"/>
                            <DataGridTextColumn Header="房间" Binding="{Binding Room}" Width="100"/>
                            <DataGridTextColumn Header="用户名" Binding="{Binding UserName}" Width="140"/>
                            <DataGridTextColumn Header="弹幕内容" Binding="{Binding Text}" Width="*"/>
                            <DataGridCheckBoxColumn Header="已屏蔽" Binding="{Binding WasBlocked}" Width="65"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="SearchStatus" Grid.Row="2" Foreground="#FF666666"/>
                </Grid>
            </TabItem>
            <TabItem Header="实时策略">
                <StackPanel Margin="18" MaxWidth="620" HorizontalAlignment="Left">
                    <TextBlock Text="滚动区实时优先；所有原始弹幕仍写入历史。放不下的弹幕在过期后不再滚动。" TextWrapping="Wrap"/>
                    <TextBlock Text="滚动候选最长等待时间（秒）" Margin="0,22,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="FreshnessSlider" Width="320" Minimum="0.2" Maximum="3" TickFrequency="0.1"
                                ValueChanged="StrategySlider_Changed"/>
                        <TextBlock x:Name="FreshnessValue" Width="70" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="重复弹幕合并窗口（秒）" Margin="0,18,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="DuplicateSlider" Width="320" Minimum="0.5" Maximum="8" TickFrequency="0.5"
                                ValueChanged="StrategySlider_Changed"/>
                        <TextBlock x:Name="DuplicateValue" Width="70" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Margin="0,22,0,0" Foreground="#FF666666" TextWrapping="Wrap"
                               Text="高峰时滚动速度会自动提升至 1.25～1.5 倍；相同弹幕合并，超过新鲜度的弹幕只保留在历史中。"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
