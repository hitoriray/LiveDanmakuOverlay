<Window x:Class="LiveDanmakuOverlay.ControlCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="弹幕姬 · 控制中心" Width="1040" Height="700" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#FFF5F6FA"
        FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#FF202534">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF6C5CE7"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF5B4CD2"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#FF747B8C"/>
        <SolidColorBrush x:Key="LineBrush" Color="#FFE6E8EF"/>

        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#FF202534"/></Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.86"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.72"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FFEFEDFD"/><Setter Property="Foreground" Value="#FF5848CB"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FFFFECEF"/><Setter Property="Foreground" Value="#FFD43B4D"/>
        </Style>
        <Style x:Key="TableActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FFF0EEFD"/><Setter Property="Foreground" Value="#FF5848CB"/>
            <Setter Property="Padding" Value="8,4"/><Setter Property="FontSize" Value="11"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,0"/>
            <Setter Property="Foreground" Value="#FF202534"/><Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="SelectionBrush" Value="#FFBDB5FA"/><Setter Property="SelectionTextBrush" Value="#FF202534"/>
            <Setter Property="FontWeight" Value="Normal"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="InputBorder" Property="BorderThickness" Value="1.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="Padding" Value="8,6"/></Style>
        <Style TargetType="ListBox"><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
        <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#FFEFEDFD"/><Setter Property="Foreground" Value="#FF5848CB"/></Trigger></Style.Triggers></Style>

        <Style TargetType="TabControl">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#FF202332" CornerRadius="14" Padding="10,14"><ItemsPresenter/></Border><Border Grid.Column="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="22" TextElement.Foreground="#FF202534"><ContentPresenter ContentSource="SelectedContent"/></Border></Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#FFB9BECA"/><Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,2"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="NavItem" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavItem" Property="Background" Value="#FF2D3142"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="NavItem" Property="Background" Value="#FF6C5CE7"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style TargetType="DataGrid"><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#FFEEF0F4"/><Setter Property="RowBackground" Value="White"/><Setter Property="AlternatingRowBackground" Value="#FFFAFAFC"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="42"/><Setter Property="CanUserResizeRows" Value="False"/><Setter Property="EnableRowVirtualization" Value="True"/></Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#FFF5F6F9"/><Setter Property="Foreground" Value="#FF596174"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,9"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#FFFAFAFC"/><Setter Property="CornerRadius" Value="11"/><Setter Property="Padding" Value="15"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
        <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style x:Key="PageDescription" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/><Setter Property="Margin" Value="0,6,0,20"/></Style>
    </Window.Resources>

    <Grid Margin="22">
        <TabControl TabStripPlacement="Left">
            <TabItem Header="账号与平台">
                <StackPanel>
                    <TextBlock Text="账号与平台" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="管理各直播平台的登录状态。" Style="{StaticResource PageDescription}"/>
                    <Border Style="{StaticResource Card}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="190" Height="190" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10">
                                <Grid><TextBlock Text="等待生成二维码" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="LoginQrImage" Stretch="Uniform" Margin="10"/></Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="20,4,0,0">
                                <TextBlock Text="哔哩哔哩" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="AccountStatus" Text="正在读取登录状态…" Margin="0,8,0,20" TextWrapping="Wrap"/>
                                <WrapPanel><Button x:Name="LoginButton" Content="扫码登录" Click="Login_Click"/><Button x:Name="LogoutButton" Content="退出登录" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Logout_Click"/></WrapPanel>
                                <TextBlock Margin="0,18,0,0" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="21" Text="登录凭据使用 Windows 当前用户加密，仅保存在本机。登录成功后自动重新连接直播间。"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </TabItem>

            <TabItem Header="屏蔽管理">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="屏蔽管理" Style="{StaticResource PageTitle}"/><TextBlock Text="正文按包含关系匹配；用户名按完整名称精确匹配。" Style="{StaticResource PageDescription}"/></StackPanel>
                    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="内容关键词" FontSize="16" FontWeight="SemiBold"/>
                            <Grid Grid.Row="1" Margin="0,12,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="KeywordInput" Height="38" KeyDown="KeywordInput_KeyDown" ToolTip="自动忽略空格、标点与大小写"/><Button Grid.Column="1" Content="添加" Margin="7,0,0,0" Click="AddKeyword_Click"/></Grid>
                            <ListBox x:Name="KeywordList" Grid.Row="2"/>
                            <Button Grid.Row="3" Content="移除选中关键词" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="RemoveKeyword_Click"/>
                        </Grid></Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="用户黑名单" FontSize="16" FontWeight="SemiBold"/>
                            <Grid Grid.Row="1" Margin="0,12,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="UserInput" Height="38" KeyDown="UserInput_KeyDown" ToolTip="输入完整用户名"/><Button Grid.Column="1" Content="添加" Margin="7,0,0,0" Click="AddUser_Click"/></Grid>
                            <ListBox x:Name="UserList" Grid.Row="2"/>
                            <Button Grid.Row="3" Content="移除选中用户" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="RemoveUser_Click"/>
                        </Grid></Border>
                    </Grid>
                    <StackPanel Grid.Row="2" Margin="0,14,0,0"><CheckBox x:Name="SaveBlockedCheck" Content="被屏蔽的弹幕仍保存到历史" Checked="SaveBlockedCheck_Changed" Unchecked="SaveBlockedCheck_Changed"/><TextBlock x:Name="BlockManagementStatus" Foreground="{StaticResource TextMutedBrush}" Margin="0,7,0,0"/></StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="历史记录">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="历史记录" Style="{StaticResource PageTitle}"/><TextBlock Text="搜索记录，并直接把某条内容或某个用户加入屏蔽。" Style="{StaticResource PageDescription}"/></StackPanel>
                    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchInput" Height="39" KeyDown="SearchInput_KeyDown" ToolTip="搜索正文、用户名或房间号"/>
                        <ComboBox x:Name="BlockedFilter" Grid.Column="1" Margin="8,0,0,0" SelectedIndex="0" SelectionChanged="BlockedFilter_SelectionChanged"><ComboBoxItem Content="全部状态"/><ComboBoxItem Content="仅正常"/><ComboBoxItem Content="仅已屏蔽"/></ComboBox>
                        <Button Grid.Column="2" Content="搜索" Margin="8,0,0,0" Click="Search_Click"/>
                    </Grid>
                    <DataGrid x:Name="HistoryGrid" Grid.Row="2" Margin="0,12" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding Timestamp, StringFormat=MM-dd HH:mm:ss}" Width="105"/>
                            <DataGridTextColumn Header="房间" Binding="{Binding Room}" Width="70"/>
                            <DataGridTextColumn Header="用户名" Binding="{Binding UserName}" Width="110"/>
                            <DataGridTextColumn Header="弹幕内容" Binding="{Binding Text}" Width="*"/>
                            <DataGridTemplateColumn Header="接收时" Width="66"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border x:Name="StatusBadge" Background="#FFEAF8EF" CornerRadius="9" Padding="7,3" HorizontalAlignment="Center"><TextBlock x:Name="StatusLabel" Text="正常" Foreground="#FF27864A" FontSize="11"/></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding WasBlocked}" Value="True"><Setter TargetName="StatusBadge" Property="Background" Value="#FFFFECEE"/><Setter TargetName="StatusLabel" Property="Text" Value="已屏蔽"/><Setter TargetName="StatusLabel" Property="Foreground" Value="#FFC93445"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="操作" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="屏蔽内容" Style="{StaticResource TableActionButton}" Click="BlockContentFromHistory_Click"/><Button Content="屏蔽用户" Style="{StaticResource TableActionButton}" Margin="5,0,0,0" Click="BlockUserFromHistory_Click"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="SearchStatus" Grid.Row="3" Foreground="{StaticResource TextMutedBrush}"/>
                    <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,12,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel><TextBlock Text="自动保留" VerticalAlignment="Center"/><ComboBox x:Name="RetentionCombo" Width="92" Margin="8,0,14,0" SelectionChanged="RetentionCombo_SelectionChanged"><ComboBoxItem Content="7 天" Tag="7"/><ComboBoxItem Content="30 天" Tag="30"/><ComboBoxItem Content="90 天" Tag="90"/><ComboBoxItem Content="永久" Tag="0"/></ComboBox><Button Content="清理过期" Style="{StaticResource SecondaryButton}" Click="CleanupHistory_Click"/><Button Content="清空全部" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="ClearHistory_Click"/><Button Content="刷新状态" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="RefreshHistoryStatus_Click"/></WrapPanel><TextBlock x:Name="HistoryStatus" Grid.Row="1" Margin="0,9,0,0" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/></Grid></Border>
                </Grid>
            </TabItem>

            <TabItem Header="实时策略">
                <StackPanel>
                    <TextBlock Text="实时策略" Style="{StaticResource PageTitle}"/><TextBlock Text="控制高峰弹幕的取舍方式，滚动速度始终保持主窗口所选档位。" Style="{StaticResource PageDescription}"/>
                    <Border Style="{StaticResource Card}" MaxWidth="650" HorizontalAlignment="Left"><StackPanel>
                        <TextBlock Text="滚动候选最长等待时间" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="超过时间的弹幕保留在历史，但不再追赶显示。" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,10"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><Slider x:Name="FreshnessSlider" Minimum="0.2" Maximum="3" TickFrequency="0.1" ValueChanged="StrategySlider_Changed"/><TextBlock x:Name="FreshnessValue" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"/></Grid>
                        <Separator Margin="0,20" Background="{StaticResource LineBrush}"/>
                        <TextBlock Text="重复弹幕合并窗口" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="短时间内相同内容只滚动一次，原始记录仍会保存。" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,10"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><Slider x:Name="DuplicateSlider" Minimum="0.5" Maximum="8" TickFrequency="0.5" ValueChanged="StrategySlider_Changed"/><TextBlock x:Name="DuplicateValue" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"/></Grid>
                    </StackPanel></Border>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
